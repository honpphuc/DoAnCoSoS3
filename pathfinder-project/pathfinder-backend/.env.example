# Example environment variables for pathfinder-backend
# Copy this file to .env and fill values before running the server.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-key

# Session secret for express-session
SESSION_SECRET=change_this_to_a_long_random_string

# Google Gemini / Generative API key (set if you want AI features)
GEMINI_API_KEY=

# Server port (optional)
PORT=3000
