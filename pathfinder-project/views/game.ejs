<%- include('partials/head') %>

<div class="flex">
  <%- include('partials/sidebar') %>

  <main class="lg:ml-64 flex-1 min-h-screen p-6 md:p-8 bg-slate-50/50">
    <!-- Header Game Zone -->
    <header class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-lg shadow-sm border border-amber-200">
            <i class="fa-solid fa-gamepad"></i>
          </div>
          <div>
            <h2 class="text-2xl font-black text-slate-900">Đấu Trường Game Ôn Tập</h2>
            <p class="text-slate-500 text-xs">Vừa chơi vừa nhớ — Biến kiến thức bài cũ thành thử thách tương tác hấp dẫn</p>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href="/review" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-teal-50 text-primary border border-teal-200 text-xs font-bold hover:bg-teal-100 transition shadow-sm">
          <i class="fa-solid fa-brain"></i>
          Ôn tập lý thuyết & Đề thi
        </a>
      </div>
    </header>

    <!-- Khu vực chọn chế độ & cấu hình game -->
    <div id="gameSetupCard" class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 md:p-8 mb-8">
      <div class="max-w-3xl mx-auto space-y-6">
        <div>
          <h3 class="text-lg font-black text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-dice text-amber-500"></i>
            Chọn chế độ chơi & Phạm vi bài học cũ
          </h3>
          <p class="text-xs text-slate-400 mt-1">AI Gemini sẽ phân tích các bài học đã qua để tạo màn chơi game độc đáo</p>
        </div>

        <!-- 2 Chế độ chơi -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card Chế độ 1: Memory Match -->
          <div onclick="selectGameMode('memory')" id="modeCard_memory"
            class="mode-card cursor-pointer p-5 rounded-2xl border-2 border-primary bg-teal-50/50 shadow-md shadow-teal-50 transition-all hover:scale-[1.01]">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-primary text-white flex items-center justify-center text-xl shrink-0 shadow-md shadow-teal-200">
                <i class="fa-solid fa-clone"></i>
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <h4 class="font-black text-slate-900 text-base">Lật Thẻ Trí Nhớ</h4>
                  <span class="text-[10px] font-bold bg-primary text-white px-2 py-0.5 rounded-full">Phổ biến</span>
                </div>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                  Lật các cặp thẻ và ghép đôi chính xác giữa <strong>Thuật ngữ / Khái niệm</strong> với <strong>Định nghĩa / Ứng dụng</strong>.
                </p>
                <div class="mt-3 flex items-center gap-3 text-[11px] font-semibold text-teal-700">
                  <span><i class="fa-regular fa-clock mr-1"></i> Tính giờ</span>
                  <span><i class="fa-solid fa-bolt mr-1"></i> Combo x2, x3</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Card Chế độ 2: Speed Quiz -->
          <div onclick="selectGameMode('speed')" id="modeCard_speed"
            class="mode-card cursor-pointer p-5 rounded-2xl border-2 border-slate-200 bg-white hover:border-amber-400 hover:bg-amber-50/20 transition-all hover:scale-[1.01]">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-xl shrink-0 shadow-md shadow-amber-200">
                <i class="fa-solid fa-stopwatch-20"></i>
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <h4 class="font-black text-slate-900 text-base">Đua Tốc Độ 10s</h4>
                  <span class="text-[10px] font-bold bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full">Kịch tính</span>
                </div>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                  Phản xạ trả lời thật nhanh trước khi đồng hồ đếm ngược 10 giây kết thúc để giữ chuỗi điểm số cao nhất!
                </p>
                <div class="mt-3 flex items-center gap-3 text-[11px] font-semibold text-amber-700">
                  <span><i class="fa-solid fa-bomb mr-1"></i> 10s mỗi câu</span>
                  <span><i class="fa-solid fa-fire mr-1"></i> Streak bùng nổ</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Chọn tuần bài học cũ -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Phạm vi bài học cũ</label>
            <select id="gameWeekSelect" class="w-full bg-slate-50 border border-slate-200 rounded-xl py-3 px-3.5 text-sm font-semibold outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500/10 transition">
              <option value="all">🌟 Toàn bộ bài học trong lộ trình</option>
              <% if (weeks && weeks.length > 0) { %>
                <% weeks.forEach(w => { %>
                  <option value="<%= w.week %>">Tuần <%= w.week %>: <%= w.theme %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="flex items-end">
            <button id="btnStartGame" onclick="loadGameFromAI()"
              class="w-full bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-black py-3 px-6 rounded-xl shadow-lg shadow-orange-200 hover:shadow-orange-300 transition-all flex items-center justify-center gap-2 text-sm active:scale-[0.98]">
              <i class="fa-solid fa-play"></i>
              Bắt đầu Trò Chơi Ngay
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- KHU VỰC CHƠI GAME (BAN ĐẦU ẨN) -->
    <div id="gamePlayArea" class="hidden space-y-6">
      <!-- Game Top Scoreboard -->
      <div class="bg-slate-900 text-white rounded-3xl p-6 md:p-8 shadow-2xl flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span id="gameBadge" class="px-2.5 py-0.5 rounded-full bg-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-wider">
              LẬT THẺ TRÍ NHỚ
            </span>
            <span class="text-xs text-slate-400" id="gameSubtitle">Ghép đôi Thuật ngữ với Định nghĩa</span>
          </div>
          <h3 class="text-xl md:text-2xl font-black text-white mt-1" id="gameSessionTitle">Màn chơi AI Pathfinder</h3>
        </div>

        <div class="flex items-center gap-4 md:gap-8">
          <div class="text-center">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Thời gian</p>
            <p class="text-2xl font-black text-teal-300 font-mono" id="gameTimer">00:00</p>
          </div>
          <div class="text-center">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Điểm số</p>
            <p class="text-2xl font-black text-amber-400" id="gameScore">0</p>
          </div>
          <div class="text-center">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Chuỗi Combo</p>
            <p class="text-2xl font-black text-orange-400 flex items-center justify-center gap-1">
              <span id="gameCombo">0</span> <i class="fa-solid fa-fire text-sm text-orange-500"></i>
            </p>
          </div>
          <button onclick="exitGame()" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition">
            <i class="fa-solid fa-arrow-rotate-left"></i>
          </button>
        </div>
      </div>

      <!-- Màn 1: Giao diện game Lật thẻ (Memory Match) -->
      <div id="memoryGameContainer" class="hidden">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4" id="cardsGrid">
          <!-- Render danh sách thẻ lật bằng JS -->
        </div>
      </div>

      <!-- Màn 2: Giao diện game Đua Tốc Độ (Speed Quiz) -->
      <div id="speedGameContainer" class="hidden max-w-2xl mx-auto">
        <div class="bg-white rounded-3xl border border-slate-200 p-6 md:p-8 shadow-xl space-y-6">
          <!-- Thanh đếm ngược 10 giây -->
          <div>
            <div class="flex justify-between items-center text-xs font-bold text-slate-500 mb-1.5">
              <span id="speedQuestionIndex">Câu 1 / 8</span>
              <span id="speedTimerNumber" class="text-orange-600 font-mono">10.0s</span>
            </div>
            <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
              <div id="speedProgressBar" class="h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full transition-all duration-100" style="width: 100%;"></div>
            </div>
          </div>

          <!-- Nội dung câu hỏi -->
          <div class="min-h-[70px] flex items-center">
            <h4 id="speedQuestionText" class="text-lg md:text-xl font-black text-slate-900 leading-snug">
              Nội dung câu hỏi đang tải...
            </h4>
          </div>

          <!-- 4 Lựa chọn -->
          <div class="space-y-3" id="speedOptionsContainer">
            <!-- Render options bằng JS -->
          </div>
        </div>
      </div>

      <!-- Modal Thắng cuộc / Hoàn thành Game -->
      <div id="gameVictoryModal" class="hidden bg-white border-2 border-amber-300 rounded-3xl p-8 max-w-md mx-auto text-center shadow-2xl space-y-5 animate-bounce-short">
        <div class="w-20 h-20 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-3xl mx-auto shadow-inner">
          <i class="fa-solid fa-trophy"></i>
        </div>
        <div>
          <span class="text-xs font-black uppercase tracking-widest text-amber-600 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
            CHIẾN THẮNG TUYỆT VỜI!
          </span>
          <h3 class="text-2xl font-black text-slate-900 mt-2">Bậc Thầy Ghi Nhớ Bài Học</h3>
          <p class="text-xs text-slate-400 mt-1" id="victorySummary">Bạn đã hoàn thành thử thách xuất sắc!</p>
        </div>

        <div class="grid grid-cols-3 gap-3 bg-slate-50 p-4 rounded-2xl text-center text-xs">
          <div>
            <p class="text-slate-400">Điểm số</p>
            <p class="text-lg font-black text-amber-600" id="finalScore">0</p>
          </div>
          <div>
            <p class="text-slate-400">Thời gian</p>
            <p class="text-lg font-black text-teal-600" id="finalTime">00:00</p>
          </div>
          <div>
            <p class="text-slate-400">Combo lớn nhất</p>
            <p class="text-lg font-black text-orange-600" id="finalCombo">0x</p>
          </div>
        </div>

        <div class="flex gap-3">
          <button onclick="loadGameFromAI()" class="flex-1 bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 rounded-xl text-xs shadow-lg shadow-amber-200 transition">
            Chơi lại màn mới
          </button>
          <button onclick="exitGame()" class="px-5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3 rounded-xl text-xs transition">
            Chọn chế độ khác
          </button>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('partials/footer', { withSidebar: true }) %>

<style>
/* 3D Flip Card Effect */
.perspective-1000 {
  perspective: 1000px;
}
.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}
.card-flipped .card-inner {
  transform: rotateY(180deg);
}
.card-front, .card-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.card-back {
  transform: rotateY(180deg);
}
@keyframes pulse-success {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}
.matched-pulse {
  animation: pulse-success 0.5s ease;
}
</style>

<script>
const allTasksData = <%- JSON.stringify(allTasks || []) %>;
const weeksData = <%- JSON.stringify(weeks || []) %>;
const roadmapGoal = <%- JSON.stringify(roadmap && roadmap.goal ? roadmap.goal : '') %>;

// State của trò chơi
let activeGameMode = 'memory';
let gameScore = 0;
let gameCombo = 0;
let maxCombo = 0;
let timerInterval = null;
let secondsElapsed = 0;

// Web Audio API hiệu ứng âm thanh sống động (không cần tải file ngoài)
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(type) {
  try {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);

    const now = audioCtx.currentTime;
    if (type === 'flip') {
      osc.frequency.setValueAtTime(400, now);
      osc.frequency.exponentialRampToValueAtTime(800, now + 0.08);
      gain.gain.setValueAtTime(0.15, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
      osc.start(now);
      osc.stop(now + 0.08);
    } else if (type === 'match') {
      osc.frequency.setValueAtTime(523.25, now); // C5
      osc.frequency.setValueAtTime(659.25, now + 0.08); // E5
      osc.frequency.setValueAtTime(783.99, now + 0.16); // G5
      gain.gain.setValueAtTime(0.2, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
      osc.start(now);
      osc.stop(now + 0.3);
    } else if (type === 'wrong') {
      osc.frequency.setValueAtTime(250, now);
      osc.frequency.exponentialRampToValueAtTime(150, now + 0.15);
      gain.gain.setValueAtTime(0.2, now);
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
      osc.start(now);
      osc.stop(now + 0.15);
    } else if (type === 'victory') {
      [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
        const o = audioCtx.createOscillator();
        const g = audioCtx.createGain();
        o.connect(g);
        g.connect(audioCtx.destination);
        o.frequency.setValueAtTime(freq, now + idx * 0.1);
        g.gain.setValueAtTime(0.2, now + idx * 0.1);
        g.gain.exponentialRampToValueAtTime(0.01, now + idx * 0.1 + 0.25);
        o.start(now + idx * 0.1);
        o.stop(now + idx * 0.1 + 0.25);
      });
    }
  } catch (e) {}
}

function selectGameMode(mode) {
  activeGameMode = mode;
  const memCard = document.getElementById('modeCard_memory');
  const spdCard = document.getElementById('modeCard_speed');

  if (mode === 'memory') {
    memCard.className = 'mode-card cursor-pointer p-5 rounded-2xl border-2 border-primary bg-teal-50/50 shadow-md shadow-teal-50 transition-all';
    spdCard.className = 'mode-card cursor-pointer p-5 rounded-2xl border-2 border-slate-200 bg-white hover:border-amber-400 hover:bg-amber-50/20 transition-all';
  } else {
    spdCard.className = 'mode-card cursor-pointer p-5 rounded-2xl border-2 border-amber-500 bg-amber-50/50 shadow-md shadow-amber-50 transition-all';
    memCard.className = 'mode-card cursor-pointer p-5 rounded-2xl border-2 border-slate-200 bg-white hover:border-primary hover:bg-teal-50/20 transition-all';
  }
}

// Bắt đầu game: Lấy dữ liệu từ AI
async function loadGameFromAI() {
  const btn = document.getElementById('btnStartGame');
  const weekVal = document.getElementById('gameWeekSelect').value;

  let selectedTasks = [];
  if (weekVal === 'all') {
    selectedTasks = allTasksData.length > 0 ? allTasksData : [];
  } else {
    const week = weeksData.find(w => String(w.week) === weekVal);
    selectedTasks = week ? (week.tasks || []) : [];
  }

  if (selectedTasks.length === 0) {
    showToast('Không có bài học nào trong tuần này.', 'warning');
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1.5"></i> Gemini đang tạo màn chơi...';

  try {
    const res = await fetch('/api/game/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        tasks: selectedTasks.map(t => ({ topic: t.topic, description: t.description || '' })),
        gameType: activeGameMode,
        goal: roadmapGoal,
      }),
    });

    const data = await res.json();
    if (!res.ok || !data.success) {
      throw new Error(data.error || 'Lỗi khi tạo dữ liệu game.');
    }

    startGameplay(data.gameData);

  } catch (err) {
    showToast(err.message || 'Không thể tạo game lúc này. Thử lại nhé!', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-play mr-1.5"></i> Bắt đầu Trò Chơi Ngay';
  }
}

function startGameplay(gameData) {
  // Ẩn bảng setup, mở khu vực chơi
  document.getElementById('gameSetupCard').classList.add('hidden');
  document.getElementById('gamePlayArea').classList.remove('hidden');
  document.getElementById('gameVictoryModal').classList.add('hidden');

  // Reset điểm & đồng hồ
  gameScore = 0;
  gameCombo = 0;
  maxCombo = 0;
  secondsElapsed = 0;
  updateScoreboard();

  clearInterval(timerInterval);
  timerInterval = setInterval(() => {
    secondsElapsed++;
    const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
    const secs = String(secondsElapsed % 60).padStart(2, '0');
    document.getElementById('gameTimer').textContent = `${mins}:${secs}`;
  }, 1000);

  if (activeGameMode === 'memory') {
    document.getElementById('gameBadge').textContent = 'LẬT THẺ TRÍ NHỚ';
    document.getElementById('gameSubtitle').textContent = 'Ghép đúng cặp Khái niệm và Định nghĩa';
    document.getElementById('memoryGameContainer').classList.remove('hidden');
    document.getElementById('speedGameContainer').classList.add('hidden');
    initMemoryGame(gameData.pairs || []);
  } else {
    document.getElementById('gameBadge').textContent = 'ĐUA TỐC ĐỘ 10S';
    document.getElementById('gameSubtitle').textContent = 'Phản xạ nhanh trước khi hết giờ';
    document.getElementById('memoryGameContainer').classList.add('hidden');
    document.getElementById('speedGameContainer').classList.remove('hidden');
    initSpeedGame(gameData.questions || []);
  }

  window.scrollTo({ top: 120, behavior: 'smooth' });
}

function updateScoreboard() {
  document.getElementById('gameScore').textContent = gameScore;
  document.getElementById('gameCombo').textContent = gameCombo;
  if (gameCombo > maxCombo) maxCombo = gameCombo;
}

function exitGame() {
  clearInterval(timerInterval);
  clearInterval(speedTimerInterval);
  document.getElementById('gamePlayArea').classList.add('hidden');
  document.getElementById('gameSetupCard').classList.remove('hidden');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// =========================================================================
// LOGIC GAME 1: LẬT THẺ TRÍ NHỚ (MEMORY MATCH)
// =========================================================================
let memoryCards = [];
let flippedCards = [];
let matchedPairsCount = 0;
let totalPairsCount = 0;
let isProcessingFlip = false;

function initMemoryGame(pairs) {
  totalPairsCount = pairs.length;
  matchedPairsCount = 0;
  flippedCards = [];
  isProcessingFlip = false;

  // Tạo mảng thẻ gồm thẻ Term và thẻ Definition
  memoryCards = [];
  pairs.forEach((p, idx) => {
    memoryCards.push({
      cardId: idx * 2 + 1,
      pairId: p.pair_id || idx + 1,
      type: 'term',
      text: p.term,
      category: p.category || '',
    });
    memoryCards.push({
      cardId: idx * 2 + 2,
      pairId: p.pair_id || idx + 1,
      type: 'definition',
      text: p.definition,
      category: p.category || '',
    });
  });

  // Xáo trộn thẻ ngẫu nhiên
  memoryCards.sort(() => Math.random() - 0.5);

  const grid = document.getElementById('cardsGrid');
  grid.innerHTML = memoryCards.map((c, i) => `
    <div class="memory-card perspective-1000 h-36 cursor-pointer select-none" data-index="${i}" onclick="flipCard(${i})">
      <div class="card-inner w-full h-full rounded-2xl shadow-sm">
        <!-- Mặt úp -->
        <div class="card-front w-full h-full rounded-2xl bg-gradient-to-br from-slate-800 to-slate-900 border-2 border-slate-700 flex flex-col items-center justify-center text-teal-400 p-4 hover:border-teal-400 transition-colors">
          <i class="fa-solid fa-cube text-2xl mb-1 opacity-60"></i>
          <span class="text-[10px] font-mono text-slate-400 font-bold">PATHFINDER</span>
        </div>
        <!-- Mặt ngửa -->
        <div class="card-back w-full h-full rounded-2xl p-4 flex flex-col justify-between text-center border-2 border-slate-200 bg-white">
          <span class="text-[9px] font-black uppercase tracking-wider text-slate-400">
            ${c.type === 'term' ? '📌 Khái niệm' : '💡 Định nghĩa'}
          </span>
          <p class="font-bold text-slate-900 text-xs sm:text-sm line-clamp-4 leading-snug">
            ${c.text}
          </p>
          <span class="text-[9px] text-slate-400 truncate">${c.category || ''}</span>
        </div>
      </div>
    </div>
  `).join('');
}

function flipCard(cardIndex) {
  if (isProcessingFlip) return;
  const cardEl = document.querySelector(`.memory-card[data-index="${cardIndex}"]`);
  if (!cardEl || cardEl.classList.contains('card-flipped') || cardEl.classList.contains('card-matched')) return;

  playSound('flip');
  cardEl.classList.add('card-flipped');
  flippedCards.push({ index: cardIndex, data: memoryCards[cardIndex], element: cardEl });

  if (flippedCards.length === 2) {
    isProcessingFlip = true;
    const [c1, c2] = flippedCards;

    if (c1.data.pairId === c2.data.pairId && c1.data.type !== c2.data.type) {
      // KHỚP CẶP THÀNH CÔNG!
      playSound('match');
      setTimeout(() => {
        c1.element.classList.add('card-matched', 'matched-pulse');
        c2.element.classList.add('card-matched', 'matched-pulse');

        const back1 = c1.element.querySelector('.card-back');
        const back2 = c2.element.querySelector('.card-back');
        back1.classList.replace('border-slate-200', 'border-teal-500');
        back1.classList.add('bg-teal-50');
        back2.classList.replace('border-slate-200', 'border-teal-500');
        back2.classList.add('bg-teal-50');

        gameCombo++;
        const points = 100 + gameCombo * 25;
        gameScore += points;
        updateScoreboard();

        matchedPairsCount++;
        flippedCards = [];
        isProcessingFlip = false;

        if (matchedPairsCount === totalPairsCount) {
          triggerVictory('Tuyệt vời! Bạn đã ghép đôi chính xác toàn bộ các thẻ kiến thức!');
        }
      }, 350);
    } else {
      // KHÔNG KHỚP
      playSound('wrong');
      gameCombo = 0;
      updateScoreboard();

      setTimeout(() => {
        c1.element.classList.remove('card-flipped');
        c2.element.classList.remove('card-flipped');
        flippedCards = [];
        isProcessingFlip = false;
      }, 950);
    }
  }
}

// =========================================================================
// LOGIC GAME 2: ĐUA TỐC ĐỘ 10 GIÂY (SPEED QUIZ)
// =========================================================================
let speedQuestions = [];
let currentSpeedIndex = 0;
let speedTimerInterval = null;
let speedTimeRemaining = 10.0;
let speedAnswered = false;

function initSpeedGame(questions) {
  speedQuestions = questions;
  currentSpeedIndex = 0;
  loadSpeedQuestion(0);
}

function loadSpeedQuestion(idx) {
  if (idx >= speedQuestions.length) {
    triggerVictory('Đỉnh cao phản xạ! Bạn đã hoàn thành toàn bộ câu hỏi tốc độ!');
    return;
  }

  speedAnswered = false;
  currentSpeedIndex = idx;
  const q = speedQuestions[idx];

  document.getElementById('speedQuestionIndex').textContent = `Câu ${idx + 1} / ${speedQuestions.length}`;
  document.getElementById('speedQuestionText').textContent = q.question;

  const container = document.getElementById('speedOptionsContainer');
  container.innerHTML = (q.options || []).map((opt, oi) => `
    <button type="button" onclick="answerSpeedQuestion(${oi})"
      class="speed-opt-btn w-full text-left p-4 rounded-2xl border-2 border-slate-200 hover:border-amber-500 hover:bg-amber-50/20 font-bold text-sm text-slate-800 transition flex items-center gap-3">
      <span class="w-7 h-7 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs font-black">
        ${['A', 'B', 'C', 'D'][oi]}
      </span>
      <span>${opt}</span>
    </button>
  `).join('');

  // Bắt đầu đếm ngược 10 giây
  clearInterval(speedTimerInterval);
  speedTimeRemaining = 10.0;
  const progressBar = document.getElementById('speedProgressBar');
  const timerNum = document.getElementById('speedTimerNumber');

  speedTimerInterval = setInterval(() => {
    speedTimeRemaining -= 0.1;
    if (speedTimeRemaining <= 0) {
      speedTimeRemaining = 0;
      clearInterval(speedTimerInterval);
      handleSpeedTimeout();
    }
    const percent = Math.max(0, (speedTimeRemaining / 10.0) * 100);
    progressBar.style.width = `${percent}%`;
    timerNum.textContent = `${speedTimeRemaining.toFixed(1)}s`;
  }, 100);
}

function answerSpeedQuestion(optIdx) {
  if (speedAnswered) return;
  speedAnswered = true;
  clearInterval(speedTimerInterval);

  const q = speedQuestions[currentSpeedIndex];
  const chosenLetter = ['A', 'B', 'C', 'D'][optIdx];
  const correctLetter = (q.answer || '').trim()[0].toUpperCase();
  const isCorrect = chosenLetter === correctLetter;

  const buttons = document.querySelectorAll('.speed-opt-btn');
  buttons.forEach((btn, idx) => {
    btn.disabled = true;
    if (['A', 'B', 'C', 'D'][idx] === correctLetter) {
      btn.classList.add('border-teal-500', 'bg-teal-50', 'text-teal-900');
    } else if (idx === optIdx && !isCorrect) {
      btn.classList.add('border-red-500', 'bg-red-50', 'text-red-900');
    }
  });

  if (isCorrect) {
    playSound('match');
    gameCombo++;
    const speedBonus = Math.round(speedTimeRemaining * 10);
    const points = 100 + speedBonus + gameCombo * 20;
    gameScore += points;
    updateScoreboard();
  } else {
    playSound('wrong');
    gameCombo = 0;
    updateScoreboard();
  }

  // Chuyển sang câu kế tiếp sau 1.2s
  setTimeout(() => {
    loadSpeedQuestion(currentSpeedIndex + 1);
  }, 1200);
}

function handleSpeedTimeout() {
  if (speedAnswered) return;
  speedAnswered = true;
  playSound('wrong');
  gameCombo = 0;
  updateScoreboard();

  const q = speedQuestions[currentSpeedIndex];
  const correctLetter = (q.answer || '').trim()[0].toUpperCase();
  document.querySelectorAll('.speed-opt-btn').forEach((btn, idx) => {
    btn.disabled = true;
    if (['A', 'B', 'C', 'D'][idx] === correctLetter) {
      btn.classList.add('border-teal-500', 'bg-teal-50', 'text-teal-900');
    }
  });

  setTimeout(() => {
    loadSpeedQuestion(currentSpeedIndex + 1);
  }, 1200);
}

// Kích hoạt Chiến Thắng
function triggerVictory(message) {
  clearInterval(timerInterval);
  clearInterval(speedTimerInterval);
  playSound('victory');

  document.getElementById('memoryGameContainer').classList.add('hidden');
  document.getElementById('speedGameContainer').classList.add('hidden');

  const victoryModal = document.getElementById('gameVictoryModal');
  document.getElementById('victorySummary').textContent = message;
  document.getElementById('finalScore').textContent = gameScore;
  document.getElementById('finalTime').textContent = document.getElementById('gameTimer').textContent;
  document.getElementById('finalCombo').textContent = `${maxCombo}x`;

  victoryModal.classList.remove('hidden');
}

function showToast(msg, type = 'info') {
  const colors = { error: 'bg-red-500', warning: 'bg-amber-500', info: 'bg-slate-900' };
  const toast = document.createElement('div');
  toast.className = `fixed bottom-5 right-5 ${colors[type] || colors.info} text-white px-5 py-3.5 rounded-2xl text-xs font-bold z-50 shadow-2xl flex items-center gap-2.5 transition-all`;
  toast.innerHTML = `<i class="fa-solid ${type === 'error' ? 'fa-circle-xmark text-red-200' : type === 'warning' ? 'fa-triangle-exclamation text-amber-200' : 'fa-circle-check text-teal-300'} text-sm"></i> <span>${msg}</span>`;
  document.body.appendChild(toast);
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transform = 'translateY(10px)';
    setTimeout(() => toast.remove(), 300);
  }, 4500);
}
</script>
