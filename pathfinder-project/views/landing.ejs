<!-- DEPLOYMENT PLAN -->
<section id="ke-hoach" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-2xl mb-14">
      <p class="text-xs font-bold text-primary uppercase tracking-widest mb-3">Kế hoạch triển khai</p>
      <h2 class="text-3xl font-black text-slate-900">Lộ trình phát triển dự án</h2>
      <p class="text-slate-500 mt-3">Chi tiết 4 giai đoạn phát triển với phân công rõ ràng cho từng thành viên nhóm.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      <!-- Phase 1 -->
      <div class="border border-slate-100 rounded-xl p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center font-black text-sm shrink-0">01</div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-bold text-slate-900">Nền tảng & Xác thực</h3>
              <span class="text-[10px] font-bold bg-blue-50 text-blue-600 px-2 py-0.5 rounded-full">Tuần 1–2</span>
            </div>
            <p class="text-sm text-slate-500 mb-3">Thiết lập hạ tầng, xác thực người dùng và cấu trúc database cơ bản.</p>
            <div class="space-y-1.5">
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-blue-500 mt-0.5"></i><span>Setup Express + Supabase + EJS</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-blue-500 mt-0.5"></i><span>Đăng ký / Đăng nhập / Session</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-blue-500 mt-0.5"></i><span>Schema: users, profiles, roadmaps, tasks</span></div>
            </div>
            <p class="text-xs text-slate-400 mt-3"><i class="fa-solid fa-user mr-1"></i>Backend Dev · <i class="fa-solid fa-database ml-1 mr-1"></i>DB Designer</p>
          </div>
        </div>
      </div>
      <!-- Phase 2 -->
      <div class="border border-slate-100 rounded-xl p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-teal-50 text-primary rounded-lg flex items-center justify-center font-black text-sm shrink-0">02</div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-bold text-slate-900">Lộ trình AI & Giao diện</h3>
              <span class="text-[10px] font-bold bg-teal-50 text-primary px-2 py-0.5 rounded-full">Tuần 3–5</span>
            </div>
            <p class="text-sm text-slate-500 mb-3">Tích hợp logic tạo lộ trình, onboarding và dashboard chính.</p>
            <div class="space-y-1.5">
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-primary mt-0.5"></i><span>Onboarding 3 bước (mục tiêu → cấp độ → thời gian)</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-primary mt-0.5"></i><span>Template roadmap IELTS / Lập trình / Thiết kế</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-primary mt-0.5"></i><span>Dashboard: tiến độ, streak, bài hôm nay</span></div>
            </div>
            <p class="text-xs text-slate-400 mt-3"><i class="fa-solid fa-user mr-1"></i>Frontend Dev · <i class="fa-solid fa-robot ml-1 mr-1"></i>AI Integration</p>
          </div>
        </div>
      </div>
      <!-- Phase 3 -->
      <div class="border border-slate-100 rounded-xl p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-orange-50 text-orange-600 rounded-lg flex items-center justify-center font-black text-sm shrink-0">03</div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-bold text-slate-900">Tài liệu & Ôn tập AI</h3>
              <span class="text-[10px] font-bold bg-orange-50 text-orange-600 px-2 py-0.5 rounded-full">Tuần 6–8</span>
            </div>
            <p class="text-sm text-slate-500 mb-3">Phát triển tính năng sinh tài liệu ôn tập và bộ đề kiểm tra tự động.</p>
            <div class="space-y-1.5">
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-orange-500 mt-0.5"></i><span>API sinh tóm tắt bài học theo tuần</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-orange-500 mt-0.5"></i><span>Bộ câu hỏi ôn tập (trắc nghiệm + tự luận)</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-orange-500 mt-0.5"></i><span>Lịch ôn thi thông minh dựa trên ngày thi</span></div>
            </div>
            <p class="text-xs text-slate-400 mt-3"><i class="fa-solid fa-user mr-1"></i>AI Dev · <i class="fa-solid fa-pen ml-1 mr-1"></i>Content Designer</p>
          </div>
        </div>
      </div>
      <!-- Phase 4 -->
      <div class="border border-slate-100 rounded-xl p-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center font-black text-sm shrink-0">04</div>
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-bold text-slate-900">Hoàn thiện & Deploy</h3>
              <span class="text-[10px] font-bold bg-purple-50 text-purple-600 px-2 py-0.5 rounded-full">Tuần 9–10</span>
            </div>
            <p class="text-sm text-slate-500 mb-3">Kiểm thử toàn diện, tối ưu hiệu năng và triển khai sản phẩm.</p>
            <div class="space-y-1.5">
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-purple-500 mt-0.5"></i><span>Unit test & E2E test các tính năng cốt lõi</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-purple-500 mt-0.5"></i><span>Deploy lên Railway / Render + Supabase Cloud</span></div>
              <div class="flex items-start gap-2 text-xs text-slate-600"><i class="fa-solid fa-check text-purple-500 mt-0.5"></i><span>Demo presentation & báo cáo đồ án</span></div>
            </div>
            <p class="text-xs text-slate-400 mt-3"><i class="fa-solid fa-users mr-1"></i>Toàn nhóm · <i class="fa-solid fa-graduation-cap ml-1 mr-1"></i>Kiểm thử & Báo cáo</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

