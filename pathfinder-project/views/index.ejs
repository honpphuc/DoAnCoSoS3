<%- include('partials/head') %>
<div class="flex">
    <%- include('partials/sidebar') %>
    <main class="lg:ml-64 flex-1 min-h-screen p-8 bg-slate-50/50">
        <!-- Header -->
        <header class="flex justify-between items-center mb-8">
            <div>
                <% const hour = new Date().getHours(); %>
                <h2 class="text-3xl font-extrabold text-slate-900">
                    Chào <%= hour < 12 ? 'buổi sáng' : hour < 18 ? 'buổi chiều' : 'buổi tối' %>,
                    <%= profile?.full_name || user?.email || 'bạn' %>! 👋
                </h2>
                <p class="text-slate-500 mt-1">
                    <% if (todayTasks && todayTasks.length > 0) { %>
                        Hôm nay bạn có <strong><%= todayTasks.filter(t => !t.is_completed).length %></strong> nhiệm vụ cần hoàn thành.
                    <% } else { %>
                        Hôm nay không có bài học — hãy nghỉ ngơi hoặc ôn tập nhé!
                    <% } %>
                </p>
            </div>
            <div class="flex items-center gap-4">
                <button class="w-12 h-12 rounded-full bg-white border border-slate-100 flex items-center justify-center text-slate-400 hover:text-primary shadow-sm">
                    <i class="fa-regular fa-bell"></i>
                </button>
                <div class="flex items-center gap-3 bg-white p-1.5 pr-4 rounded-full border border-slate-100 shadow-sm">
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(profile?.full_name || user?.email || 'User') %>&background=0D7C8A&color=fff"
                         class="w-9 h-9 rounded-full object-cover" alt="Ảnh đại diện">
                    <span class="font-bold text-sm"><%= profile?.full_name || user?.email || 'Người dùng' %></span>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-12 gap-8">
            <!-- Left -->
            <div class="col-span-8 space-y-8">
                <!-- Progress Grid -->
                <div class="grid grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm group hover:border-primary/20 transition-all">
                        <div class="w-12 h-12 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <i class="fa-regular fa-clock text-xl"></i>
                        </div>
                        <p class="text-slate-400 text-sm font-medium uppercase tracking-wider">Hoàn thành</p>
                        <p class="text-3xl font-black mt-1"><%= done || 0 %><span class="text-sm font-normal text-slate-400 ml-1">bài</span></p>
                        <% if (total > 0) { %>
                        <p class="text-xs text-slate-400 mt-1"><%= Math.round((done||0)/total*100) %>% lộ trình</p>
                        <% } %>
                    </div>
                    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm group hover:border-primary/20 transition-all">
                        <div class="w-12 h-12 bg-teal-50 text-teal-500 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-book-open text-xl"></i>
                        </div>
                        <p class="text-slate-400 text-sm font-medium uppercase tracking-wider">Tổng bài học</p>
                        <p class="text-3xl font-black mt-1"><%= total || 0 %><span class="text-sm font-normal text-slate-400 ml-1">bài</span></p>
                        <% if (roadmap?.total_weeks) { %>
                        <p class="text-xs text-slate-400 mt-1"><%= roadmap.total_weeks %> tuần học</p>
                        <% } %>
                    </div>
                    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm group hover:border-primary/20 transition-all">
                        <div class="w-12 h-12 bg-orange-50 text-orange-500 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-fire text-xl"></i>
                        </div>
                        <p class="text-slate-400 text-sm font-medium uppercase tracking-wider">Chuỗi (Streak)</p>
                        <p class="text-3xl font-black mt-1"><%= streak || 0 %><span class="text-sm font-normal text-slate-400 ml-1">ngày</span></p>
                        <p class="text-xs text-slate-400 mt-1">liên tiếp</p>
                    </div>
                </div>

                <!-- Progress bar lộ trình -->
                <% if (total > 0) { %>
                <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-bold text-slate-800"><%= roadmap?.title || 'Lộ trình của tôi' %></h3>
                        <span class="text-sm font-bold text-primary"><%= percent || 0 %>%</span>
                    </div>
                    <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden">
                        <div class="bg-primary h-full rounded-full transition-all" style="width: <%= percent || 0 %>%"></div>
                    </div>
                    <p class="text-xs text-slate-400 mt-2"><%= done %> / <%= total %> bài hoàn thành</p>
                </div>
                <% } %>

                <!-- Trọng tâm hôm nay -->
                <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-8">
                    <div class="flex justify-between items-center mb-8">
                        <h3 class="text-xl font-bold flex items-center gap-3">
                            <i class="fa-solid fa-bullseye text-primary"></i> Trọng tâm hôm nay
                        </h3>
                        <div class="flex items-center gap-2">
                            <div class="w-32 bg-slate-100 h-2 rounded-full overflow-hidden">
                                <div class="bg-primary h-full" style="width: <%= todayTasks && todayTasks.length > 0 ? Math.round(todayTasks.filter(t=>t.is_completed).length/todayTasks.length*100) : 0 %>%"></div>
                            </div>
                            <span class="text-xs font-bold text-slate-500">
                                <%= todayTasks ? todayTasks.filter(t=>t.is_completed).length : 0 %>/<%= todayTasks ? todayTasks.length : 0 %>
                            </span>
                        </div>
                    </div>
                    <div class="space-y-4" id="dailyFocusList">
                        <% if (!todayTasks || todayTasks.length === 0) { %>
                            <div class="text-center py-8">
                                <i class="fa-regular fa-calendar-check text-4xl text-slate-200 mb-3"></i>
                                <p class="text-slate-400">Hôm nay không có bài học nào!</p>
                                <a href="/schedule" class="text-primary text-sm font-bold mt-2 inline-block">Xem lịch học →</a>
                            </div>
                        <% } else { %>
                            <% todayTasks.forEach((task) => { %>
                                <div class="flex items-center gap-4 p-4 rounded-2xl <%= task.is_completed ? 'bg-teal-50 border border-teal-100' : 'bg-slate-50 border border-slate-100' %>">
                                    <input type="checkbox" <%= task.is_completed ? 'checked' : '' %>
                                           onchange="toggleTask('<%= task.id %>', this.checked)"
                                           class="w-5 h-5 rounded-lg accent-primary">
                                    <div class="flex-1">
                                        <p class="font-bold text-sm <%= task.is_completed ? 'line-through text-slate-400' : '' %>"><%= task.topic %></p>
                                        <p class="text-xs text-slate-400"><%= task.duration_min %> phút • <%= task.week_theme || '' %></p>
                                    </div>
                                    <a href="/lesson/<%= task.id %>" class="text-primary text-sm font-bold">Học →</a>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Right -->
            <div class="col-span-4 space-y-8">
                <!-- Lịch sắp tới: task tuần này chưa hoàn thành -->
                <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6">
                    <h3 class="text-lg font-bold mb-6">Bài học sắp tới</h3>
                    <% 
                      const upcoming = (todayTasks || []).filter(t => !t.is_completed).slice(0, 3);
                    %>
                    <% if (upcoming.length === 0) { %>
                        <p class="text-sm text-slate-400 text-center py-4">Tất cả bài hôm nay đã hoàn thành! 🎉</p>
                        <a href="/schedule" class="block text-center text-primary text-sm font-bold mt-2">Xem lịch học →</a>
                    <% } else { %>
                    <div class="space-y-4">
                        <% upcoming.forEach((task, i) => { %>
                        <div class="flex gap-4">
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 rounded-full <%= i === 0 ? 'bg-primary' : 'bg-slate-200' %> mt-1.5"></div>
                                <% if (i < upcoming.length - 1) { %><div class="w-0.5 h-full bg-slate-100 my-1"></div><% } %>
                            </div>
                            <div>
                                <p class="text-[10px] font-bold <%= i === 0 ? 'text-primary' : 'text-slate-400' %> uppercase">
                                    <%= i === 0 ? 'Tiếp theo' : 'Sau đó' %> • <%= task.duration_min %> phút
                                </p>
                                <p class="font-bold text-slate-800 text-sm"><%= task.topic %></p>
                                <p class="text-xs text-slate-400"><%= task.week_theme || '' %></p>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>

                <!-- Gợi ý dựa trên lộ trình thật -->
                <div class="bg-primary rounded-3xl p-6 text-white relative overflow-hidden shadow-xl shadow-teal-50">
                    <div class="relative z-10">
                        <p class="text-xs font-bold bg-white/20 inline-block px-2 py-0.5 rounded mb-3">Lộ trình của bạn</p>
                        <p class="font-bold text-lg mb-2"><%= roadmap?.title || 'Bắt đầu học thôi!' %></p>
                        <p class="text-sm text-teal-50/80 mb-4">
                            <% if (total > 0 && done < total) { %>
                                Còn <%= total - done %> bài học nữa để hoàn thành lộ trình.
                            <% } else if (done >= total && total > 0) { %>
                                Bạn đã hoàn thành toàn bộ lộ trình! Xuất sắc! 🏆
                            <% } else { %>
                                Hãy bắt đầu bài học đầu tiên của bạn.
                            <% } %>
                        </p>
                        <a href="/roadmap" class="inline-block bg-white text-primary px-4 py-2 rounded-xl text-xs font-bold hover:bg-teal-50 transition-colors">
                            Xem lộ trình →
                        </a>
                    </div>
                    <i class="fa-solid fa-map-location-dot absolute -bottom-4 -right-4 text-7xl opacity-10 -rotate-12"></i>
                </div>
            </div>
        </div>
    </main>
</div>
<%- include('partials/footer', { withSidebar: true }) %>
<script>
    async function toggleTask(taskId, isCompleted) {
        try {
            const res = await fetch('/api/tasks/' + taskId + '/complete', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_completed: isCompleted }),
            });
            if (!res.ok) { alert('Cập nhật không thành công'); return; }
            location.reload();
        } catch (err) {
            alert('Lỗi kết nối server');
        }
    }
</script>
</body>
</html>
